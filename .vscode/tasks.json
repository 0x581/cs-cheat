{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "create-build-dir",
            "type": "shell",
            "command": "mkdir \"${workspaceFolder}/build/output/Release\" \"${workspaceFolder}/build/output/Debug\" \"${workspaceFolder}/build/output/DebugNoInputHook\" || echo 0",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Creates the build directory if it does not exist",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "never",
                "close": true
            }
        },
        {
            "label": "cmake-build-debug",
            "type": "shell",
            "command": "cmake --build \"${workspaceFolder}/build\" --config Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Builds the project with CMake for Debug configuration",
            "dependsOn": "create-build-dir"
        },
        {
            "label": "cmake-build-debug-no-input-hook",
            "type": "shell",
            "command": "cmake --build \"${workspaceFolder}/build\" --config DebugNoInputHook",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Builds the project with CMake for DebugNoInputHook configuration",
            "dependsOn": "create-build-dir"
        },
        {
            "label": "cmake-build-release",
            "type": "shell",
            "command": "cmake --build \"${workspaceFolder}/build\" --config Release",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Builds the project with CMake for Release configuration",
            "dependsOn": "create-build-dir"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "del /Q /S \"${workspaceFolder}/build\" || echo 0 && ROBOCOPY \"${workspaceFolder}/build\" \"${workspaceFolder}/build\" /S /MOVE || echo 0",
            "group": {
                "kind": "none",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Clean build artifacts from the workspace",
            "presentation": {
                "reveal": "silent",
                "revealProblems": "never",
                "close": true
            }
        }
    ]
}